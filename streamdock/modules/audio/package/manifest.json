{
  "Name": "Taskbar Tiles Audio Control worker",
  "Description": "All available Windows capture endpoint mute worker for Taskbar Tiles.",
  "Author": "Taskbar Tiles / FoughtApple",
  "Category": "Taskbar Tiles",
  "CategoryIcon": "images/mic-live.png",
  "Icon": "images/mic-live.png",
  "Version": "1.2.1",
  "SDKVersion": 1,
  "CodePath": "plugin/AudioControl.exe",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "3.10.188.226"
  },
  "Actions": [
    {
      "UUID": "com.foughtapple.audiocontrol.microphone",
      "Name": "Audio Control - Microphone",
      "Tooltip": "Mute every available Windows microphone; press again to unmute every microphone. Shows actual aggregate state.",
      "Icon": "images/mic-live.png",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/mic-unavailable.png",
          "Title": "",
          "ShowTitle": true,
          "TitleAlignment": "top",
          "FontSize": "10"
        }
      ],
      "PropertyInspectorPath": "inspector/index.html"
    }
  ]
}
